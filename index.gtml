<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Машинная вышивка — с. Барда | ИП Мавлютова С.Л.</title>
  <meta name="description" content="Эксклюзивная машинная вышивка на кепках, одежде и аксессуарах. Национальные орнаменты, брендирование. с. Барда, Пермский край." />
  <style>
    /* ============ ПАЛИТРА (ТАТАРСКИЙ НАЦИОНАЛЬНЫЙ СТИЛЬ) ============ */
    :root {
      --ruby: #9c1f2c;       /* рубиновый */
      --ruby-dark: #6e121b;
      --gold: #d4a017;       /* золото */
      --emerald: #1f7a3d;    /* изумруд */
      --cream: #faf6ee;      /* молочный крем */
      --dark: #2b1a1e;       /* тёмный бордово-коричневый */
      --white: #ffffff;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Segoe UI', 'Arial', sans-serif;
      color: var(--dark);
      background-color: var(--cream);
      line-height: 1.6;
      overflow-x: hidden;
    }

    a { text-decoration: none; color: inherit; }

    .container { max-width: 1150px; margin: 0 auto; padding: 0 20px; }

    /* ============ ШАПКА ============ */
    header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: linear-gradient(90deg, var(--ruby-dark), var(--ruby));
      color: var(--white);
      box-shadow: 0 4px 15px rgba(0,0,0,0.25);
    }

    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 20px;
      max-width: 1150px;
      margin: 0 auto;
      gap: 15px;
      flex-wrap: wrap;
    }

    .brand { display: flex; align-items: center; gap: 12px; }

    /* ЛОГОТИП — монограмма МВ */
    .logo {
      width: 56px;
      height: 56px;
      flex-shrink: 0;
      background: var(--white);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 0 3px var(--gold), 0 0 0 6px var(--ruby);
    }

    .logo svg { width: 38px; height: 38px; }

    .brand-text { line-height: 1.1; }
    .brand-text h1 { font-size: 1.15rem; font-weight: 700; letter-spacing: 0.5px; }
    .brand-text span { font-size: 0.78rem; opacity: 0.9; }

    nav ul {
      display: flex;
      gap: 22px;
      list-style: none;
      font-weight: 600;
      font-size: 0.95rem;
    }

    nav li { cursor: pointer; transition: color .2s, border-color .2s; }
    nav li a { border-bottom: 2px solid transparent; padding-bottom: 3px; }
    nav li a:hover { color: var(--gold); border-color: var(--gold); }

    .header-cta { display: flex; align-items: center; gap: 10px; }
    .phone { font-weight: 700; white-space: nowrap; }

    .btn {
      display: inline-block;
      padding: 10px 18px;
      border-radius: 40px;
      font-weight: 700;
      cursor: pointer;
      transition: transform .2s, box-shadow .2s;
      border: none;
      font-size: 0.95rem;
    }
    .btn:hover { transform: translateY(-2px); }

    .btn-gold { background: var(--gold); color: var(--dark); }
    .btn-ruby { background: var(--ruby); color: var(--white); }

    /* БУРГЕР-МЕНЮ ДЛЯ МОБИЛЬНЫХ */
    .burger {
      display: none;
      background: none;
      border: none;
      color: var(--white);
      font-size: 1.8rem;
      cursor: pointer;
    }

    /* ============ HERO (ВИЗУАЛ С ФОНОМ ОРНАМЕНТА) ============ */
    .hero {
      position: relative;
      color: var(--white);
      padding: 90px 0;
      overflow: hidden;
      background: linear-gradient(135deg, rgba(110,18,27,0.95), rgba(156,31,44,0.9)), var(--ruby);
    }

    /* Фон — полупрозрачное полотно с орнаментом (Фото №7) */
    .hero::before {
      content: "";
      position: absolute;
      inset: 0;
      background: url('https://static.mashagpt.ru/dl/mashagpt/sekumyexrdz40y0b6lkwac4y.webp') center/cover no-repeat;
      opacity: 0.18; /* полупрозрачный орнамент */
    }

    .hero-inner {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: center;
      gap: 50px;
      flex-wrap: wrap;
    }

    .hero-left { flex: 1 1 480px; }

    .hero-left .eyebrow {
      color: var(--gold);
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      font-size: 0.85rem;
      margin-bottom: 15px;
    }

    .hero-left h2 { font-size: 2.5rem; line-height: 1.2; margin-bottom: 18px; }
    .hero-left h2 span { color: var(--gold); }
    .hero-left p { font-size: 1.1rem; opacity: 0.95; margin-bottom: 28px; max-width: 520px; }

    .hero-actions { display: flex; gap: 15px; flex-wrap: wrap; }

    /* Фото №1 — девушка в кепке */
    .hero-right { flex: 1 1 380px; text-align: center; }
    .hero-right img {
      width: 100%;
      max-width: 420px;
      border-radius: 20px;
      border: 5px solid var(--gold);
      box-shadow: 0 20px 50px rgba(0,0,0,0.4);
    }

    /* ============ УСЛУГИ ============ */
    .section { padding: 80px 0; }
    .section-head { text-align: center; margin-bottom: 50px; }
    .section-head h2 { font-size: 2rem; color: var(--ruby); }
    .section-head p { color: #777; margin-top: 10px; }

    .services {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 25px;
    }

    .card {
      background: var(--white);
      border-radius: 16px;
      padding: 30px 22px;
      text-align: center;
      box-shadow: 0 10px 30px rgba(0,0,0,0.08);
      transition: transform .3s, box-shadow .3s;
      border-top: 5px solid var(--ruby);
      cursor: pointer;
    }

    .card:hover { transform: translateY(-10px); box-shadow: 0 18px 40px rgba(0,0,0,0.15); }

    .card .icon { font-size: 2.6rem; margin-bottom: 15px; }
    .card h3 { color: var(--ruby); margin-bottom: 10px; }
    .card p { color: #666; font-size: 0.95rem; }

    /* ============ ГАЛЕРЕЯ ============ */
    .gallery {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 18px;
    }

    .gallery-item {
      position: relative;
      border-radius: 14px;
      overflow: hidden;
      cursor: pointer;
      height: 240px;
    }

    .gallery-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform .4s;
    }

    .gallery-item:hover img { transform: scale(1.1); }
    .gallery-item::after {
      content: "✂️ Нажмите, чтобы увеличить";
      position: absolute;
      bottom: 0;
      left: 0; right: 0;
      background: rgba(110,18,27,0.85);
      color: #fff;
      padding: 8px;
      font-size: 0.8rem;
      text-align: center;
      transform: translateY(100%);
      transition: transform .3s;
    }
    .gallery-item:hover::after { transform: translateY(0); }

    /* ============ ПРЕИМУЩЕСТВА ============ */
    .features {
      background: linear-gradient(135deg, var(--ruby-dark), var(--ruby));
      color: var(--white);
    }
    .features .section-head h2 { color: var(--white); }
    .features .section-head p { color: rgba(255,255,255,0.8); }

    .feature-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 25px;
    }

    .feature {
      background: rgba(255,255,255,0.1);
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 14px;
      padding: 25px;
      text-align: center;
    }
    .feature .num { font-size: 2.2rem; font-weight: 800; color: var(--gold); }
    .feature h3 { margin: 10px 0 8px; }
    .feature p { font-size: 0.92rem; opacity: 0.9; }

    /* ============ КОНТАКТЫ (С ФОНОМ ОРНАМЕНТА) ============ */
    .contacts { position: relative; padding: 80px 0; overflow: hidden; background: var(--cream); }
    /* Фон — полупрозрачное полотно с орнаментом (Фото №7) */
    .contacts::before {
      content: "";
      position: absolute;
      inset: 0;
      background: url('https://static.mashagpt.ru/dl/mashagpt/sekumyexrdz40y0b6lkwac4y.webp') center/cover no-repeat;
      opacity: 0.12;
    }

    .contacts-inner {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 40px;
      align-items: center;
    }

    .contact-info { background: var(--white); border-radius: 16px; padding: 30px; box-shadow: 0 15px 40px rgba(0,0,0,0.1); border-left: 6px solid var(--ruby); }
    .contact-info h2 { color: var(--ruby); margin-bottom: 20px; }
    .contact-row { display: flex; gap: 12px; align-items: center; margin-bottom: 18px; font-size: 1.02rem; }
    .contact-row .ic { font-size: 1.5rem; }

    .map-wrap { border-radius: 16px; overflow: hidden; box-shadow: 0 15px 40px rgba(0,0,0,0.15); border: 4px solid var(--ruby); min-height: 320px; }

    /* ============ ФУТЕР ============ */
    footer {
      background: var(--dark);
      color: rgba(255,255,255,0.85);
      text-align: center;
      padding: 30px 20px;
      font-size: 0.9rem;
    }
    footer strong { color: var(--gold); }

    /* ============ ФОРМА МОДАЛЬНОГО ОКНА ============ */
    .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.7);
      z-index: 200;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }
    .modal.show { display: flex; }

    .modal-body { background: var(--white); border-radius: 16px; max-width: 500px; width: 100%; padding: 35px; position: relative; }
    .modal-body h3 { color: var(--ruby); margin-bottom: 8px; }
    .modal-body p { color: #666; margin-bottom: 20px; }
    .modal-close { position: absolute; top: 12px; right: 16px; font-size: 1.6rem; cursor: pointer; color: #999; background: none; border: none; }

    input, textarea, select {
      width: 100%;
      padding: 13px 15px;
      margin-bottom: 14px;
      border: 2px solid #ddd;
      border-radius: 10px;
      font-size: 1rem;
      font-family: inherit;
    }
    input:focus, textarea:focus, select:focus { outline: none; border-color: var(--gold); }

    /* ============ АНИМАЦИИ ПОЯВЛЕНИЯ ============ */
    .reveal { opacity: 0; transform: translateY(30px); transition: opacity .7s, transform .7s; }
    .reveal.visible { opacity: 1; transform: translateY(0); }

    /* ============ АДАПТИВНОСТЬ ============ */
    @media (max-width: 820px) {
      nav { display: none; }
      .burger { display: block; }
      nav.open { display: block; position: absolute; top: 100%; left: 0; right: 0; background: var(--ruby); padding: 20px; }
      nav.open ul { flex-direction: column; gap: 15px; }
      nav.open ul li { font-size: 1.1rem; }
      .hero-left h2 { font-size: 1.9rem; }
      .header-cta .btn-gold { display: none; }
      .section { padding: 55px 0; }
    }
  </style>
</head>
<body>

  <!-- ============ ШАПКА ============ -->
  <header>
    <div class="header-inner">
      <div class="brand">
        <!-- ЛОГОТИП "МВ" -->
        <div class="logo" aria-label="Логотип Машинная вышивка">
          <svg viewBox="0 0 100 100" fill="none">
            <text x="50" y="72" text-anchor="middle"
                  font-family="Georgia, serif" font-size="62" font-weight="bold"
                  fill="none" stroke="#9c1f2c" stroke-width="3">МВ</text>
            <text x="50" y="72" text-anchor="middle"
                  font-family="Georgia, serif" font-size="62" font-weight="bold"
                  fill="#d4a017">МВ</text>
          </svg>
        </div>
        <div class="brand-text">
          <h1>Машинная вышивка</h1>
          <span>handmade · ИП Мавлютова С.Л. · с. Барда</span>
        </div>
      </div>

      <button class="burger" id="burger" aria-label="Меню">☰</button>

      <nav id="nav">
        <ul>
          <li><a href="#services">Услуги</a></li>
          <li><a href="#gallery">Работы</a></li>
          <li><a href="#features">Почему мы</a></li>
          <li><a href="#contacts">Контакты</a></li>
        </ul>
      </nav>

      <div class="header-cta">
        <span class="phone">📞 8 992 227-28-04</span>
        <button class="btn btn-gold" onclick="openForm()">Рассчитать стоимость</button>
      </div>
    </div>
  </header>

  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-left reveal">
        <div class="eyebrow">Handmade · Ручная работа</div>
        <h2>Эксклюзивная <span>машинная вышивка</span> на кепках и одежде</h2>
        <p>Воплощаем ваши идеи в стежках: надписи, логотипы, национальные орнаменты. Ателье ИП Мавлютова С.Л. — село Барда, Пермский край.</p>
        <div class="hero-actions">
          <button class="btn btn-gold" onclick="openForm()">Рассчитать стоимость</button>
          <a class="btn btn-ruby" href="https://vk.ru/svetkachvey" target="_blank" rel="noopener">Мы во ВКонтакте</a>
        </div>
      </div>
      <div class="hero-right reveal">
        <img src="https://static.mashagpt.ru/dl/mashagpt/zb74mocrmjqzua4irdlvwdyj.webp" alt="Кепка с машинной вышивкой" />
      </div>
    </div>
  </section>

  <!-- ============ УСЛУГИ ============ -->
  <section class="section" id="services">
    <div class="container">
      <div class="section-head reveal">
        <h2>Наши возможности</h2>
        <p>Что мы можем вышить для вас</p>
      </div>
      <div class="services">
        <div class="card reveal">
          <div class="icon">🧢</div>
          <h3>Вышивка на кепках</h3>
          <p>Надписи и логотипы на бейсболках любых цветов и размеров.</p>
        </div>
        <div class="card reveal">
          <div class="icon">🌸</div>
          <h3>Национальные орнаменты</h3>
          <p>Традиционные татарские и народные узоры — наша фирменная фишка.</p>
        </div>
        <div class="card reveal">
          <div class="icon">👕</div>
          <h3>Брендирование одежды</h3>
          <p>Логотипы компании на худи, футболках, спецодежде и рабочей форме.</p>
        </div>
        <div class="card reveal">
          <div class="icon">✏️</div>
          <h3>Индивидуальные заказы</h3>
          <p>Воплотим ваш эскиз или идею в качественную машинную вышивку.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ ГАЛЕРЕЯ ============ -->
  <section class="section" id="gallery" style="background:#f4ede1;">
    <div class="container">
      <div class="section-head reveal">
        <h2>Наши работы</h2>
        <p>Живые фото из нашей мастерской</p>
      </div>
      <div class="gallery">
        <div class="gallery-item reveal"><img src="https://static.mashagpt.ru/dl/mashagpt/zb74mocrmjqzua4irdlvwdyj.webp" alt="Кепка с вышивкой" /></div>
        <div class="gallery-item reveal"><img src="https://static.mashagpt.ru/dl/mashagpt/go7gf4vsn8mfwnpj152x3rns.webp" alt="Изделия с орнаментом" /></div>
        <div class="gallery-item reveal"><img src="https://static.mashagpt.ru/dl/mashagpt/h1nzkioszs4evg6qt5i12pbi.webp" alt="Ткань с орнаментом" /></div>
        <div class="gallery-item reveal"><img src="https://static.mashagpt.ru/dl/mashagpt/d5pp0ibui33vrpned2z6m16t.webp" alt="Процесс раскроя" /></div>
        <div class="gallery-item reveal"><img src="https://static.mashagpt.ru/dl/mashagpt/hw8yxjome0cyovncnqi26ago.webp" alt="Готовая работа" /></div>
        <div class="gallery-item reveal"><img src="https://static.mashagpt.ru/dl/mashagpt/s7wrfwn4raaje305fz82r8ea.webp" alt="Рукоделие" /></div>
      </div>
    </div>
  </section>

  <!-- ============ ПРЕИМУЩЕСТВА ============ -->
  <section class="section features" id="features">
    <div class="container">
      <div class="section-head reveal">
        <h2>Почему выбирают нас</h2>
        <p>Ателье с проверенной репутацией в Барде</p>
      </div>
      <div class="feature-grid">
        <div class="feature reveal">
          <div class="num">01</div>
          <h3>Местное производство</h3>
          <p>Работаем в селе Барда, Пермский край. Живой контакт с клиентом.</p>
        </div>
        <div class="feature reveal">
          <div class="num">02</div>
          <h3>Любая сложность</h3>
          <p>От простых надписей на кепках до многоцветных этнических орнаментов.</p>
        </div>
        <div class="feature reveal">
          <div class="num">03</div>
          <h3>Ручная работа</h3>
          <p>Handmade подход — каждое изделие создаётся с душой и вниманием к деталям.</p>
        </div>
        <div class="feature reveal">
          <div class="num">04</div>
          <h3>Качество и сроки</h3>
          <p>Современное оборудование, аккуратные стежки и соблюдение сроков.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ КОНТАКТЫ ============ -->
  <section class="contacts" id="contacts">
    <div class="container contacts-inner">
      <div class="contact-info reveal">
        <h2>Контакты</h2>
        <div class="contact-row"><span class="ic">📍</span><span>Пермский край, с. Барда, ул. Куйбышева, 104</span></div>
        <div class="contact-row"><span class="ic">📞</span><span>8 992 227-28-04</span></div>
        <div class="contact-row"><span class="ic">🏢</span><span>Ателье ИП Мавлютова С.Л.</span></div>
        <div class="contact-row"><span class="ic">💬</span><span>VK: <a href="https://vk.ru/svetkachvey" target="_blank" rel="noopener" style="color:var(--ruby); font-weight:700;">vk.ru/svetkachvey</a></span></div>
        <button class="btn btn-ruby" onclick="openForm()" style="margin-top:10px;">Оставить заявку</button>
      </div>
      <div class="map-wrap reveal">
        <iframe
          src="https://yandex.ru/map-widget/v1/?text=Пермский%20край%2C%20Барда%2C%20Куйбышева%20104"
          width="100%" height="320" style="border:0;" allowfullscreen loading="lazy"></iframe>
      </div>
    </div>
  </section>

  <!-- ============ ФУТЕР ============ -->
  <footer>
    <p>© 2025 <strong>Машинная вышивка</strong> — ателье ИП Мавлютова С.Л. | с. Барда, Пермский край</p>
    <p style="margin-top:6px;">Handmade · ручная машинная вышивка на заказ</p>
  </footer>

  <!-- ============ МОДАЛЬНОЕ ОКНО (ЗАЯВКА) ============ -->
  <div class="modal" id="formModal">
    <div class="modal-body">
      <button class="modal-close" onclick="closeForm()">×</button>
      <h3>Рассчитать стоимость</h3>
      <p>Оставьте заявку — мы свяжемся с вами для обсуждения деталей.</p>
      <form onsubmit="submitForm(event)">
        <input type="text" placeholder="Ваше имя" required />
        <input type="tel" placeholder="Телефон" required />
        <select>
          <option>Вышивка на кепке</option>
          <option>Национальный орнамент</option>
          <option>Брендирование одежды</option>
          <option>Индивидуальный заказ</option>
        </select>
        <textarea placeholder="Опишите вашу идею (необязательно)" rows="3"></textarea>
        <button type="submit" class="btn btn-gold" style="width:100%;">Отправить заявку</button>
      </form>
      <p id="formMsg" style="color:var(--emerald); font-weight:700; display:none;">✅ Спасибо! Мы свяжемся с вами в ближайшее время.</p>
    </div>
  </div>

  <script>
    // ===== БУРГЕР-МЕНЮ =====
    const burger = document.getElementById('burger');
    const nav = document.getElementById('nav');
    burger.addEventListener('click', () => nav.classList.toggle('open'));

    // ===== АНИМАЦИЯ ПОЯВЛЕНИЯ ПРИ СКРОЛЛЕ =====
    const revealEls = document.querySelectorAll('.reveal');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } });
    }, { threshold: 0.15 });
    revealEls.forEach(el => observer.observe(el));

    // ===== МОДАЛЬНОЕ ОКНО =====
    function openForm() { document.getElementById('formModal').classList.add('show'); }
    function closeForm() { document.getElementById('formModal').classList.remove('show'); }
    function submitForm(e) {
      e.preventDefault();
      document.getElementById('formMsg').style.display = 'block';
      setTimeout(closeForm, 1800);
    }

    // Закрытие по клику на подложку
    document.getElementById('formModal').addEventListener('click', (e) => {
      if (e.target.id === 'formModal') closeForm();
    });
  </script>

</body>
</html>
